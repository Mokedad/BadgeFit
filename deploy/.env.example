# BadgeFit server settings. deploy/setup.sh writes deploy/.env from this and your answers.

# ── Your domains ──────────────────────────────────────────────────────────
# Point both at the server's IP address (DNS "A" records) before starting.
SITE_DOMAIN=badgefit.example
APP_DOMAIN=app.badgefit.example
# For Let's Encrypt expiry notices.
ACME_EMAIL=you@example.com

# ── The app (read by the api container) ───────────────────────────────────
# Passkeys are bound to this exact host. Never change it once people have signed up.
RP_ID=app.badgefit.example
ORIGIN=https://app.badgefit.example
RP_NAME=BadgeFit
# The first profile created becomes the admin (admin dashboard, Jarvis setup, invites,
# moderating the community). Sign up yourself straight after the first start.
FIRST_USER_ADMIN=1
# Sign in with a name and password as well as passkeys: easier for new members.
PASSWORD_LOGIN=1
# Everyone needs an account: the community lives on the server.
ALLOW_GUEST=0
# Set to 1 to require an invite code (made in the admin dashboard) for new sign-ups.
INVITE_ONLY=0

# ── Music (optional) ──────────────────────────────────────────────────────
# A Spotify developer app's Client ID (public, no secret). Redirect URI to add there:
# https://<APP_DOMAIN>/
SPOTIFY_CLIENT_ID=
