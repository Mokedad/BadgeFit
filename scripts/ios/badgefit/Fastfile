# BadgeFit to TestFlight (.github/workflows/badgefit-testflight.yml copies this into
# frontend/ios/App/fastlane/ on the Mac runner). App Store signing made for the run with the App
# Store Connect API key: a distribution certificate and an App Store profile, so no registered
# device is needed (Xcode's automatic signing asks for one). A run's certificate is revoked by the
# next run, not by itself, so certificates do not pile up against Apple's limit and an uploaded
# build keeps a valid signature while Apple processes it.
default_platform(:ios)

BUNDLE_ID = 'au.com.badgefit.app'

platform :ios do
  lane :testflight_build do
    key = app_store_connect_api_key(
      key_id: ENV.fetch('ASC_KEY_ID'),
      issuer_id: ENV.fetch('ASC_ISSUER_ID'),
      key_filepath: ENV.fetch('ASC_KEY_FILE'),
      in_house: false
    )
    setup_ci # a temporary keychain for the certificate
    cert_id = nil
    begin # (kept as a block: the signing steps read as one)
      require 'openssl'
      require 'base64'
      require 'fileutils'
      Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
        key_id: ENV.fetch('ASC_KEY_ID'), issuer_id: ENV.fetch('ASC_ISSUER_ID'), filepath: ENV.fetch('ASC_KEY_FILE'))
      dist = Spaceship::ConnectAPI::Certificate::CertificateType::DISTRIBUTION
      # The certificates of earlier runs are revoked here, at the start of the next one, never at
      # the end of their own: Apple checks an upload's signature while it processes the build,
      # minutes after the upload, and a certificate revoked by then makes the build "Invalid
      # Signature" (ITMS-90035, build 110). The newest is kept while it may still be in that
      # check (made within the last 45 minutes); this account signs only here.
      require 'time'
      olds = Spaceship::ConnectAPI::Certificate.all(filter: { certificateType: dist })
      made_at = ->(c) { (Time.parse(c.expiration_date.to_s) - 365 * 86_400 rescue Time.at(0)) }
      olds = olds.sort_by { |c| made_at.call(c) }.reverse
      olds.each_with_index do |old, i|
        if i.zero? && Time.now - made_at.call(old) < 45 * 60
          UI.message("keeping the last run's certificate (#{old.id}): its build may still be processing")
          next
        end
        UI.message("revoking an earlier run's distribution certificate (#{old.id})")
        old.delete!
      end
      # A fresh key and certificate for this run, into the temporary keychain.
      sign_dir = File.join(File.expand_path('..', Dir.pwd), 'build', 'signing') # the lane runs in fastlane/
      FileUtils.mkdir_p(sign_dir)
      pkey = OpenSSL::PKey::RSA.new(2048)
      csr = OpenSSL::X509::Request.new
      csr.version = 0
      csr.subject = OpenSSL::X509::Name.parse('/CN=BadgeFit CI/C=AU')
      csr.public_key = pkey.public_key
      csr.sign(pkey, OpenSSL::Digest.new('SHA256'))
      made = Spaceship::ConnectAPI::Certificate.create(certificate_type: dist, csr_content: csr.to_pem)
      cert_id = made.id
      File.write(File.join(sign_dir, 'dist.key'), pkey.to_pem)
      File.binwrite(File.join(sign_dir, 'dist.cer'), Base64.decode64(made.certificate_content))
      kc = 'fastlane_tmp_keychain'
      import_certificate(certificate_path: File.join(sign_dir, 'dist.key'), keychain_name: kc, keychain_password: '', log_output: true)
      import_certificate(certificate_path: File.join(sign_dir, 'dist.cer'), keychain_name: kc, keychain_password: '', log_output: true)
      sh('security find-identity -v -p codesigning | tail -3')
      get_provisioning_profile(api_key: key, app_identifier: BUNDLE_ID, cert_id: cert_id,
                               force: true, output_path: sign_dir, filename: 'BadgeFit_AppStore.mobileprovision')
      profile = lane_context[SharedValues::SIGH_NAME]
      update_code_signing_settings(
        use_automatic_signing: false, path: 'App.xcodeproj', targets: ['App'],
        team_id: ENV.fetch('APPLE_TEAM_ID'), bundle_identifier: BUNDLE_ID,
        code_sign_identity: 'Apple Distribution', profile_name: profile
      )
      build_app(
        workspace: 'App.xcworkspace', scheme: 'App', configuration: 'Release',
        export_method: 'app-store', output_directory: 'build', output_name: 'BadgeFit.ipa',
        export_options: { provisioningProfiles: { BUNDLE_ID => profile }, uploadSymbols: true },
        buildlog_path: 'build', xcargs: "DEVELOPMENT_TEAM=#{ENV.fetch('APPLE_TEAM_ID')}"
      )
      upload_to_testflight(api_key: key, ipa: 'build/BadgeFit.ipa', skip_waiting_for_build_processing: true)
    end
  end
end
